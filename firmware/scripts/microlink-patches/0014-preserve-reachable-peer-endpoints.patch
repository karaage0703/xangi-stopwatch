+/* Keep same-subnet IPv4 endpoints even when they appear after many Docker
+ * interfaces. Scan the whole list; the wire format order is not priority. */
+static void parse_peer_endpoints_for_network(ml_peer_update_t *update,
+        const cJSON *endpoints, uint32_t local_ip, uint32_t mask) {
+    update->endpoint_count = 0;
+    for (int pass = 0; pass < 2; ++pass) {
+        const cJSON *ep;
+        cJSON_ArrayForEach(ep, endpoints) {
+            if (update->endpoint_count >= ML_MAX_ENDPOINTS) return;
+            if (!ep->valuestring) continue;
+            unsigned a, b, c, d, port;
+            char extra;
+            if (sscanf(ep->valuestring, "%u.%u.%u.%u:%u%c",
+                       &a, &b, &c, &d, &port, &extra) != 5 ||
+                a > 255 || b > 255 || c > 255 || d > 255 ||
+                port == 0 || port > 65535) continue;
+            uint32_t ip = (a << 24) | (b << 16) | (c << 8) | d;
+            if (ip == 0) continue;
+            bool local = mask && local_ip && ((ip & mask) == (local_ip & mask));
+            if ((pass == 0) != local) continue;
+            bool duplicate = false;
+            for (int j = 0; j < update->endpoint_count; ++j) {
+                if (update->endpoints[j].ip == ip && update->endpoints[j].port == port)
+                    duplicate = true;
+            }
+            if (duplicate) continue;
+            int i = update->endpoint_count++;
+            update->endpoints[i].ip = ip;
+            update->endpoints[i].port = (uint16_t)port;
+            update->endpoints[i].is_ipv6 = false;
+        }
+    }
+}
+
+static void parse_peer_endpoints(ml_peer_update_t *update, const cJSON *endpoints) {
+    esp_netif_ip_info_t info = {0};
+    esp_netif_t *sta = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    if (sta) esp_netif_get_ip_info(sta, &info);
+    parse_peer_endpoints_for_network(update, endpoints,
+                                    ntohl(info.ip.addr), ntohl(info.netmask.addr));
+}
+
 static const char *TAG = "ml_coord";
 
