  * Unified DERP I/O Task
  * ========================================================================== */
 
+/* DERP regions do not forward to each other. Keep our home connection for
+ * inbound traffic and a second, on-demand connection for the configured server.
+ * Both TLS sessions are owned by this task; no context swapping or shared I/O. */
+static void derp_disconnect_conn(ml_derp_conn_t *conn) {
+    conn->connected = false;
+    if (conn->sockfd >= 0) {
+        mbedtls_ssl_close_notify(&conn->ssl);
+        ml_close_sock(conn->sockfd);
+        conn->sockfd = -1;
+    }
+    mbedtls_ssl_free(&conn->ssl);
+    mbedtls_ssl_config_free(&conn->ssl_conf);
+    mbedtls_ctr_drbg_free(&conn->ctr_drbg);
+    mbedtls_entropy_free(&conn->entropy);
+}
+
+static bool derp_region_endpoint(microlink_t *ml, uint16_t region,
+                                 const char **host, int *port) {
+    for (int i = 0; i < ml->derp_region_count; ++i) {
+        const ml_derp_region_t *r = &ml->derp_regions[i];
+        if (r->region_id != region) continue;
+        for (int j = 0; j < r->node_count; ++j) {
+            if (r->nodes[j].stun_only || !r->nodes[j].hostname[0]) continue;
+            *host = r->nodes[j].hostname;
+            *port = r->nodes[j].derp_port > 0 ? r->nodes[j].derp_port : ML_DERP_PORT;
+            return true;
+        }
+        return false;
+    }
+    /* The compiled host belongs only to its compiled region. Never silently
+     * send Tokyo-bound traffic to Dallas when a map is not available yet. */
+    if (region == ML_DERP_REGION) {
+        *host = ML_DERP_HOST;
+        *port = ML_DERP_PORT;
+        return true;
+    }
+    return false;
+}
+
+static uint16_t derp_destination_region(microlink_t *ml, const uint8_t *key) {
+    for (int i = 0; i < ml->peer_count; ++i) {
+        const ml_peer_t *p = &ml->peers[i];
+        if (p->active && memcmp(p->public_key, key, 32) == 0)
+            return p->derp_region;
+    }
+    return 0;
+}
+
+static bool derp_is_priority_destination(microlink_t *ml, const uint8_t *key) {
+    if (!ml->config.priority_peer_ip) return false;
+    for (int i = 0; i < ml->peer_count; ++i) {
+        const ml_peer_t *p = &ml->peers[i];
+        if (p->active && p->vpn_ip == ml->config.priority_peer_ip &&
+            memcmp(p->public_key, key, 32) == 0)
+            return true;
+    }
+    return false;
+}
+
+static esp_err_t derp_connect_region(microlink_t *ml, ml_derp_conn_t *conn,
+                                      uint16_t region);
+
+static ml_derp_conn_t *derp_outbound_connection(microlink_t *ml,
+        ml_derp_conn_t *outbound, const uint8_t *key, uint64_t *retry_at) {
+    uint16_t region = derp_destination_region(ml, key);
+    if (!region) return NULL; /* Wait for authenticated peer metadata. */
+    if (ml->derp.connected && ml->derp.region == region) return &ml->derp;
+    if (outbound->connected && outbound->region == region) return outbound;
+    /* StopWatch has one configured server. Background probes must not evict
+     * its relay connection when other tailnet peers use different regions. */
+    if (!derp_is_priority_destination(ml, key)) return NULL;
+    if (outbound->region != region) {
+        derp_disconnect_conn(outbound);
+        outbound->region = region;
+        *retry_at = 0;
+    }
+    if (ml_get_time_ms() < *retry_at) return NULL;
+    if (derp_connect_region(ml, outbound, region) != ESP_OK) {
+        derp_disconnect_conn(outbound);
+        *retry_at = ml_get_time_ms() + 10000;
+        return NULL;
+    }
+    *retry_at = 0;
+    return outbound;
+}
