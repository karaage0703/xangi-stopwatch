--- a/components/microlink/src/microlink.c
+++ b/components/microlink/src/microlink.c
@@ -97,6 +97,7 @@
     }
 
     if (need_save) {
+        nvs_erase_key(nvs, "vpn_ip");
         nvs_set_blob(nvs, NVS_KEY_MACHINE_PRI, ml->machine_private_key, 32);
         nvs_set_blob(nvs, NVS_KEY_MACHINE_PUB, ml->machine_public_key, 32);
         nvs_set_blob(nvs, NVS_KEY_WG_PRI, ml->wg_private_key, 32);
@@ -106,11 +107,30 @@
         nvs_commit(nvs);
         ESP_LOGI(TAG, "Keys saved to NVS");
     } else {
+        uint32_t cached_ip = 0;
+        if (nvs_get_u32(nvs, "vpn_ip", &cached_ip) == ESP_OK &&
+            (cached_ip & 0xffc00000U) == 0x64400000U) {
+            ml->vpn_ip = cached_ip;
+        }
         ESP_LOGI(TAG, "Keys loaded from NVS");
     }
 
     nvs_close(nvs);
     return ESP_OK;
+}
+
+/* Cache only addresses assigned by the authenticated control server. The
+ * address shares the identity namespace and is erased whenever keys change. */
+void ml_cache_vpn_ip(microlink_t *ml, uint32_t ip) {
+    if ((ip & 0xffc00000U) != 0x64400000U) return;
+    ml->vpn_ip = ip;
+    nvs_handle_t nvs;
+    if (nvs_open(NVS_NAMESPACE, NVS_READWRITE, &nvs) != ESP_OK) return;
+    uint32_t old_ip = 0;
+    if (nvs_get_u32(nvs, "vpn_ip", &old_ip) != ESP_OK || old_ip != ip) {
+        if (nvs_set_u32(nvs, "vpn_ip", ip) == ESP_OK) nvs_commit(nvs);
+    }
+    nvs_close(nvs);
 }
 
